{
  "name": "jdbc-sink-postgres",
  "config": {
    "connector.class": "io.confluent.connect.jdbc.JdbcSinkConnector",
    "tasks.max": "1",
    "topics": "data.cdc.kafka.test_cdc",
    "connection.url": "jdbc:postgresql://postgres:5432/testdb",
    "connection.user": "debezium",
    "connection.password": "dbz",
    "table.name.format": "kafka.kafka_events",
    "auto.create": "false",
    "auto.evolve": "false",
    "insert.mode": "insert",
    "pk.mode": "none",
    "delete.enabled": "false",

    "heartbeat.interval.ms": "5000",

    "key.converter": "org.apache.kafka.connect.json.JsonConverter",
    "key.converter.schemas.enable": "false",
    "value.converter": "org.apache.kafka.connect.json.JsonConverter",
    "value.converter.schemas.enable": "false",

    "transforms": "ValueToJson",


    "transforms.ValueToJson.type": "com.github.cedelsb.kafka.connect.smt.Record2JsonStringConverter$Value",
    "transforms.ValueToJson.json.string.field.name": "value",

    "table.types": "TABLE"
  }
}
